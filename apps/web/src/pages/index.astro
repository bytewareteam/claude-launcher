---
import Layout from '../layouts/Layout.astro'
import AppPreview from '../components/AppPreview.astro'
import logo from '@claude-launcher/design-tokens/logo.svg?url'

const repo = 'https://github.com/bytewareteam/claude-launcher'
const download = `${repo}/releases/latest`

// Trazos de iconos de lucide (MIT), 24×24.
const features = [
  {
    title: 'Proyectos y repos',
    text: 'Agrupa varios repositorios git bajo un mismo proyecto y cambia de contexto en un clic.',
    icon: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>'
  },
  {
    title: 'Worktrees a la vista',
    text: 'Cambios sin commitear y commits por delante de la rama base en cada worktree. Ábrelo o elimínalo.',
    icon: '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>'
  },
  {
    title: 'Bóveda KeePass',
    text: 'Variables de entorno por proyecto y repo en un .kdbx compatible con KeePassXC. Importa desde .env.',
    icon: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>'
  },
  {
    title: 'Lanza Claude Code',
    text: 'Una pestaña de Windows Terminal en la carpeta elegida, con solo las variables de ese proyecto.',
    icon: '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>'
  },
  {
    title: 'Inicio con actividad',
    text: 'Sesiones recientes, resumen de actividad y avisos de worktrees con cambios pendientes.',
    icon: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>'
  },
  {
    title: 'Búsqueda global',
    text: 'Ctrl+K para saltar a cualquier proyecto, repo, worktree o sesión sin tocar el ratón.',
    icon: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>'
  },
  {
    title: 'Repo en la web',
    text: 'Un botón abre el remoto en el navegador: GitHub, Azure DevOps o cualquier URL https o ssh.',
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>'
  },
  {
    title: 'Extensiones',
    text: 'Instala integraciones desde el catálogo o un .zip. Cada una pide permisos antes de activarse.',
    icon: '<path d="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z"/>'
  },
  {
    title: 'Tutorial guiado',
    text: 'La primera vez te acompaña paso a paso: proyecto, repo, bóveda y Claude. Repítelo desde Inicio.',
    icon: '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>'
  }
]

// Extensiones publicadas en el catálogo (extensions/ del repo).
const extensions = [
  {
    name: 'GitHub',
    text: 'Lista tus repositorios con GitHub CLI y clónalos en cualquier proyecto.',
    perms: ['gh'],
    icon: '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>'
  },
  {
    name: 'Azure DevOps',
    text: 'Recorre tus organizaciones con Azure CLI, lista sus repos y clónalos donde quieras.',
    perms: ['az', 'git'],
    icon: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>'
  },
  {
    name: 'Azure Boards',
    text: 'Añade a cada proyecto las pestañas Sprint y Kanban: métricas tuyas y del equipo, historias filtrables por persona, sus tareas y comentarios.',
    perms: ['az', 'git'],
    icon: '<path d="M6 5v11"/><path d="M12 5v6"/><path d="M18 5v14"/>'
  }
]

const extensionSafety = [
  ['Proceso aislado', 'Cada extensión corre en su propio proceso y nunca ve la bóveda.'],
  ['UI declarativa', 'Devuelven JSON que pinta la app: su código no llega a la ventana.'],
  ['Permisos explícitos', 'Solo se activan tras aceptarlos, y se vuelven a pedir si cambian.'],
  ['Descarga verificada', 'Cada .zip del catálogo se comprueba con su sha256 antes de instalarse.']
]

const security = [
  ['Cifrado fuerte', 'KDBX 4 con Argon2id, protegido por tu contraseña maestra.'],
  ['Sin argumentos', 'Los secretos llegan a Claude por entorno, nunca por línea de comandos.'],
  ['Entorno limpio', 'La terminal solo hereda una lista blanca de variables del sistema.'],
  ['Autobloqueo', 'La bóveda se bloquea a los 15 min y el portapapeles se limpia a los 30 s.']
]

const requirements = [
  ['Windows 10/11', 'https://www.microsoft.com/windows'],
  ['Git', 'https://git-scm.com'],
  ['Claude Code en el PATH', 'https://docs.claude.com/en/docs/claude-code'],
  ['Windows Terminal (recomendado)', 'https://aka.ms/terminal']
]
---

<Layout
  title="Claude Launcher — proyectos, secretos y Claude Code en un clic"
  description="App de escritorio para Windows que organiza tus repos y worktrees, guarda sus secretos en una bóveda KeePass y abre Claude Code con las variables correctas."
>
  <header class="sticky top-0 z-10 border-b bg-background/80 backdrop-blur">
    <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6">
      <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 font-semibold">
        <img src={logo} alt="" class="size-7" />
        Claude Launcher
      </a>
      <div class="ml-auto flex items-center gap-5 text-sm text-muted-foreground">
        <a href="#funciones" class="hover:text-foreground max-sm:hidden">Funciones</a>
        <a href="#extensiones" class="hover:text-foreground max-sm:hidden">Extensiones</a>
        <a href="#seguridad" class="hover:text-foreground max-sm:hidden">Seguridad</a>
        <a href={repo} class="hover:text-foreground">GitHub</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-x-0 -top-40 mx-auto h-96 max-w-3xl rounded-full bg-primary/15 blur-3xl"
      >
      </div>
      <div class="relative mx-auto max-w-6xl px-4 pt-20 pb-16 text-center sm:px-6 sm:pt-28">
        <img src={logo} alt="Logo de Claude Launcher" class="mx-auto mb-8 size-24" />
        <h1 class="mx-auto max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
          Tus proyectos, sus secretos y <span class="text-primary">Claude Code</span>, en un clic
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-pretty text-muted-foreground">
          Organiza repositorios y worktrees, guarda las variables de entorno en una bóveda KeePass
          y abre Claude en Windows Terminal con exactamente las que necesita. Nada más.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a
            href={download}
            class="inline-flex h-11 items-center gap-2 rounded-lg bg-primary px-6 font-medium text-primary-foreground transition hover:bg-primary/90 focus-visible:ring-4 focus-visible:ring-ring/40"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
                points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"
              ></line></svg
            >
            Descargar para Windows
          </a>
          <a
            href={repo}
            class="inline-flex h-11 items-center rounded-lg border bg-secondary px-6 font-medium text-secondary-foreground transition hover:bg-accent"
          >
            Ver código
          </a>
        </div>
        <p class="mt-4 text-sm text-muted-foreground">
          Ejecutable portable · sin instalación · gratis y de código abierto (MIT)
        </p>
      </div>

      <div class="relative mx-auto max-w-5xl px-4 pb-24 sm:px-6">
        <AppPreview />
      </div>
    </section>

    <section id="funciones" class="border-t bg-sidebar/50 py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-3xl font-semibold tracking-tight">Todo lo que rodea a una sesión de Claude</h2>
        <p class="mt-3 max-w-2xl text-muted-foreground">
          Deja de buscar la carpeta, copiar el .env y exportar variables a mano.
        </p>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map((f) => (
              <article class="rounded-xl border bg-card p-6 text-card-foreground">
                <div class="mb-4 grid size-10 place-items-center rounded-lg bg-primary/15 text-primary">
                  <svg
                    class="size-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={f.icon}
                  />
                </div>
                <h3 class="font-semibold">{f.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground">{f.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="extensiones" class="border-t py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-3xl font-semibold tracking-tight">Amplíalo con extensiones</h2>
        <p class="mt-3 max-w-2xl text-muted-foreground">
          La app viene limpia. En <strong class="text-foreground">Extensiones → Disponibles</strong>
          instalas las que necesites; cada una se actualiza con su propia versión.
        </p>
        <div class="mt-12 grid gap-4 lg:grid-cols-3">
          {
            extensions.map((e) => (
              <article class="flex flex-col rounded-xl border bg-card p-6 text-card-foreground">
                <div class="mb-4 flex items-center gap-3">
                  <div class="grid size-10 place-items-center rounded-lg bg-primary/15 text-primary">
                    <svg
                      class="size-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={e.icon}
                    />
                  </div>
                  <h3 class="font-semibold">{e.name}</h3>
                </div>
                <p class="flex-1 text-sm text-muted-foreground">{e.text}</p>
                <p class="mt-5 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                  Ejecuta
                  {e.perms.map((p) => (
                    <code class="rounded bg-secondary px-1.5 py-0.5 font-mono text-secondary-foreground">
                      {p}
                    </code>
                  ))}
                </p>
              </article>
            ))
          }
        </div>
        <dl class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            extensionSafety.map(([title, text]) => (
              <div class="border-l-2 border-primary pl-4">
                <dt class="font-medium">{title}</dt>
                <dd class="mt-1 text-sm text-muted-foreground">{text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-10 text-sm text-muted-foreground">
          ¿Quieres crear la tuya? Lee la
          <a
            href={`${repo}/blob/main/extensions/README.md`}
            class="text-primary underline-offset-4 hover:underline">guía de extensiones</a
          >.
        </p>
      </div>
    </section>

    <section id="seguridad" class="border-t bg-sidebar/50 py-24">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="text-3xl font-semibold tracking-tight">Tus secretos no salen de tu equipo</h2>
          <p class="mt-3 text-muted-foreground">
            Los datos viven en <code class="font-mono text-sm text-foreground"
              >%APPDATA%\claude-launcher\</code
            >. No hay cuentas ni servidores: no se envía nada a ningún sitio.
          </p>
          <dl class="mt-8 grid gap-6 sm:grid-cols-2">
            {
              security.map(([title, text]) => (
                <div class="border-l-2 border-primary pl-4">
                  <dt class="font-medium">{title}</dt>
                  <dd class="mt-1 text-sm text-muted-foreground">{text}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="overflow-hidden rounded-xl border bg-card font-mono text-sm" aria-label="Ejemplo de sesión">
          <div class="flex items-center gap-2 border-b px-4 py-2.5 text-xs text-muted-foreground">
            <span class="size-2.5 rounded-full bg-muted"></span>
            <span class="size-2.5 rounded-full bg-muted"></span>
            <span class="size-2.5 rounded-full bg-muted"></span>
            <span class="ml-2">Windows Terminal · tienda/web-checkout</span>
          </div>
          <pre class="overflow-x-auto p-5 leading-relaxed"><code><span class="text-muted-foreground">PS C:\dev\tienda\web-checkout&gt;</span> claude
<span class="text-muted-foreground"># Entorno inyectado por Claude Launcher</span>
<span class="text-primary">DATABASE_URL</span>      = ••••••••
<span class="text-primary">STRIPE_SECRET_KEY</span> = ••••••••
<span class="text-muted-foreground"># + PATH, USERPROFILE y otras imprescindibles</span>

<span class="text-primary">✻</span> Welcome to Claude Code!</code></pre>
        </div>
      </div>
    </section>

    <section class="border-t py-24">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-semibold tracking-tight">Empieza en un minuto</h2>
          <ol class="mt-8 space-y-5">
            <li class="flex gap-4">
              <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary text-sm font-semibold text-primary-foreground">1</span>
              <p>
                Descarga el <code class="font-mono text-sm">.exe</code> portable de la
                <a href={download} class="text-primary underline-offset-4 hover:underline">última release</a>.
              </p>
            </li>
            <li class="flex gap-4">
              <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary text-sm font-semibold text-primary-foreground">2</span>
              <p>
                Sigue el tutorial de bienvenida: crea un proyecto y añade tus repos (o clónalos con
                las extensiones de GitHub y Azure DevOps).
              </p>
            </li>
            <li class="flex gap-4">
              <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary text-sm font-semibold text-primary-foreground">3</span>
              <p>Guarda sus secretos en la bóveda y pulsa <strong>Abrir Claude</strong>.</p>
            </li>
          </ol>
        </div>
        <div>
          <h3 class="text-lg font-semibold">Requisitos</h3>
          <ul class="mt-4 divide-y rounded-xl border bg-card">
            {
              requirements.map(([name, href]) => (
                <li>
                  <a href={href} class="flex items-center justify-between px-5 py-3.5 hover:bg-accent">
                    <span>{name}</span>
                    <span class="text-muted-foreground">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm text-muted-foreground">
            ¿Prefieres compilarlo? Clona el repo y ejecuta <code class="font-mono">npm install</code> y
            <code class="font-mono">npm run dev</code> (Node.js 20+).
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t py-10 text-sm text-muted-foreground">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-4 px-4 sm:px-6">
      <img src={logo} alt="" class="size-5" />
      <span>Claude Launcher · MIT · Willian Monoga</span>
      <span class="ml-auto flex gap-5">
        <a href={`${repo}/releases`} class="hover:text-foreground">Releases</a>
        <a href={`${repo}/blob/main/CHANGELOG.md`} class="hover:text-foreground">Changelog</a>
        <a href={repo} class="hover:text-foreground">GitHub</a>
      </span>
    </div>
    <p class="mx-auto mt-4 max-w-6xl px-4 text-xs sm:px-6">
      Proyecto independiente, no afiliado a Anthropic. Claude es una marca de Anthropic.
    </p>
  </footer>
</Layout>
