{
  "name": "azure-boards",
  "displayName": "Azure Boards",
  "version": "0.0.0",
  "description": "Añade a cada proyecto una pestaña Board con el sprint actual de Azure DevOps: historias, tareas y bugs por estado, y tus historias asignadas.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "package": "node ../../scripts/extensions.mjs pack ."
  },
  "nx": {
    "name": "ext-azure-boards"
  },
  "claudeLauncher": {
    "apiVersion": 1,
    "permissions": {
      "exec": [
        "az",
        "git"
      ]
    },
    "projectTabs": [
      {
        "id": "board",
        "title": "Board",
        "icon": "kanban"
      }
    ]
  }
}
