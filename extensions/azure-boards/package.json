{
  "name": "azure-boards",
  "displayName": "Azure Boards",
  "version": "0.1.0",
  "description": "Añade a cada proyecto un dashboard del sprint de Azure DevOps (estado, tus historias y sus tareas) y un kanban de las historias del sprint filtrable por persona.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "package": "node ../../scripts/extensions.mjs pack ."
  },
  "nx": {
    "name": "ext-azure-boards"
  },
  "claudeLauncher": {
    "apiVersion": 1,
    "permissions": {
      "exec": [
        "az",
        "git"
      ]
    },
    "projectTabs": [
      {
        "id": "dashboard",
        "title": "Sprint",
        "icon": "layout-dashboard"
      },
      {
        "id": "kanban",
        "title": "Kanban",
        "icon": "kanban"
      }
    ]
  }
}
