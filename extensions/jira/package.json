{
  "name": "jira",
  "displayName": "Jira",
  "version": "0.1.0",
  "description": "Añade a cada proyecto una pestaña de Jira Cloud con el kanban del sprint activo (con sus subtareas), tus incidencias y un botón para iniciar su desarrollo con Claude Code.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "package": "node ../../scripts/extensions.mjs pack ."
  },
  "nx": {
    "name": "ext-jira"
  },
  "claudeLauncher": {
    "apiVersion": 1,
    "permissions": {
      "secrets": true,
      "develop": true
    },
    "board": {
      "title": "Jira",
      "icon": "kanban"
    },
    "projectTabs": [
      {
        "id": "jira",
        "title": "Jira",
        "icon": "kanban"
      }
    ]
  }
}
