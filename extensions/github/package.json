{
  "name": "github",
  "displayName": "GitHub",
  "version": "1.1.0",
  "description": "Lista tus repositorios de GitHub (vía GitHub CLI) y clónalos donde quieras.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "package": "node ../../scripts/extensions.mjs pack ."
  },
  "nx": {
    "name": "ext-github"
  },
  "claudeLauncher": {
    "apiVersion": 1,
    "permissions": {
      "exec": ["gh"],
      "projects": true,
      "dialogs": true
    },
    "views": [{ "id": "repos", "title": "GitHub", "icon": "cloud" }],
    "repoSources": [{ "id": "repos", "title": "GitHub", "icon": "cloud" }]
  }
}
